{
  "name": "surfer-skills-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "check": "tsc --noEmit && prettier --check scripts/*.ts package.json tsconfig.json",
    "check:packaging": "node scripts/check-packaging.ts",
    "build:plugin": "node scripts/build-plugin.ts",
    "format": "prettier --write scripts/*.ts package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/tar-stream": "3.1.5",
    "prettier": "3.9.9",
    "tar-stream": "3.2.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
